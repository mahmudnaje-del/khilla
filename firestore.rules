rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Canonical collection of Sheikh Dr. Abdul Bari Khalla fatwas
    match /fatwas/{fatwaId} {
      allow read, write: if true;
    }

    // Atomic metadata counters and sequences (e.g. fatwa_sequence)
    match /metadata/{docId} {
      allow read, write: if true;
    }
  }
}


