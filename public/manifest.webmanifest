{
  "name": "مفرّغ فتاوى الشيخ د. عبد الباري خلة",
  "short_name": "مفرّغ الفتاوى",
  "description": "منصة تفريغ وترتيب فتاوى فضيلة الشيخ د. عبد الباري خلة",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f2",
  "theme_color": "#1b2a41",
  "lang": "ar",
  "dir": "rtl",
  "id": "/",
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": ["*/*", "audio/*", "video/*", "audio/ogg", "audio/ogg; codecs=opus", "application/ogg", "application/octet-stream", ".opus", ".ogg", ".mp3", ".m4a", ".wav", ".amr", ".mp4"]
        }
      ]
    }
  }
}
